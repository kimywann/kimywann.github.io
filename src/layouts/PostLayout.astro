---
import BaseLayout from "./BaseLayout.astro";
import "../styles/post.css";

interface IPostLayoutProps {
  title: string;
  description: string;
  date: Date;
  category?: string;
  tags: string[];
}

const props = Astro.props as IPostLayoutProps;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("ko-KR", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
};
---

<BaseLayout title={props.title} description={props.description}>
  <main class="post-layout">
    <article>
      <header class="post-header">
        {props.category && <p class="post-category">{props.category}</p>}
        <h1>{props.title}</h1>
        <div class="post-date">
          <time datetime={props.date.toISOString()}>
            {formatDate(props.date)}
          </time>
        </div>
        {
          props.tags.length > 0 && (
            <ul class="post-tags" aria-label="태그 목록">
              {props.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )
        }
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>
